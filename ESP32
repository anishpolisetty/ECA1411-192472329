    display.print("OCC");

  } else {

    display.print("FREE");
  }


  // ==========================================================
  // AVAILABLE SLOTS
  // ==========================================================

  display.setCursor(0, 43);

  display.print("Available: ");

  display.print(availableSlots);


  // ==========================================================
  // GATE STATUS
  // ==========================================================

  display.setCursor(0, 56);

  if (vehicleEntering &&
      availableSlots > 0) {

    display.print("IN: GATE OPEN");

  }

  else if (vehicleExiting) {

    display.print("OUT: GATE OPEN");

  }

  else if (availableSlots == 0 &&
           !gateIsOpen) {

    display.print("PARKING FULL");

  }

  else if (gateIsOpen) {

    display.print("GATE: OPEN");

  }

  else {

    display.print("GATE: CLOSED");
  }


  display.display();
}
// ============================================================
// ADD VEHICLE HISTORY
// ============================================================

void addHistory(String type, String slot) {

  // Shift older records down

  if (historyCount < MAX_HISTORY) {

    historyCount++;

  }

  for (int i = historyCount - 1; i > 0; i--) {

    history[i] = history[i - 1];

  }


  // ==========================================================
  // GENERATE VEHICLE ID
  // ==========================================================

  String vehicleID = "VH-";

  if (vehicleNumber < 10) {

    vehicleID += "00";

  }

  else if (vehicleNumber < 100) {

    vehicleID += "0";

  }

  vehicleID += String(vehicleNumber);


  vehicleNumber++;

  if (vehicleNumber > 999) {

    vehicleNumber = 1;

  }


  // ==========================================================
  // CURRENT DATE AND TIME
  // ==========================================================

  String currentDate =
    getCurrentDate();

  String currentTime =
    getCurrentTime();


  // ==========================================================
  // SAVE RECORD
  // ==========================================================

  history[0].vehicleID =
    vehicleID;

  history[0].type =
    type;

  history[0].date =
    currentDate;

  history[0].time =
    currentTime;

  history[0].slot =
    slot;

  history[0].duration =
    "--";


  // ==========================================================
  // SERIAL OUTPUT
  // ==========================================================

  Serial.println();
  Serial.println("================================");
  Serial.println("       VEHICLE HISTORY");
  Serial.println("================================");

  Serial.print("Vehicle ID: ");
  Serial.println(vehicleID);

  Serial.print("Type: ");
  Serial.println(type);

  Serial.print("Date: ");
  Serial.println(currentDate);

  Serial.print("Time: ");
  Serial.println(currentTime);

  Serial.print("Slot: ");
  Serial.println(slot);

  Serial.println("================================");
}


// ============================================================
// FIND AVAILABLE PARKING SLOT
// ============================================================

String getAvailableSlot() {

  if (!slot1Occupied) {

    return "S1";

  }

  if (!slot2Occupied) {

    return "S2";

  }

  if (!slot3Occupied) {

    return "S3";

  }

  if (!slot4Occupied) {

    return "S4";

  }

  return "--";
}


// ============================================================
// FIND ACTIVE VEHICLE IN SLOT
// ============================================================

int findActiveVehicle(String slot) {

  for (int i = 0; i < 4; i++) {

    if (
      activeVehicles[i].active &&
      activeVehicles[i].slot == slot
    ) {

      return i;

    }
  }

  return -1;
}


// ============================================================
// REGISTER VEHICLE ENTRY
// ============================================================

void registerVehicleEntry(String slot) {

  // Make sure the slot isn't already registered

  if (findActiveVehicle(slot) != -1) {

    return;
  }


  // Find an empty active-vehicle record

  for (int i = 0; i < 4; i++) {

    if (!activeVehicles[i].active) {

      // Generate vehicle ID

      String vehicleID = "VH-";

      if (vehicleNumber < 10) {

        vehicleID += "00";

      }

      else if (vehicleNumber < 100) {

        vehicleID += "0";

      }

      vehicleID += String(vehicleNumber);


      vehicleNumber++;

      if (vehicleNumber > 999) {

        vehicleNumber = 1;

      }


      // Save active vehicle

      activeVehicles[i].vehicleID =
        vehicleID;

      activeVehicles[i].slot =
        slot;

      activeVehicles[i].entryMillis =
        millis();

      activeVehicles[i].active =
        true;


      // Add history

      addHistory(
        "ENTRY",
        slot
      );


      // Keep the same ID in history

      history[0].vehicleID =
        vehicleID;


      Serial.println();
      Serial.println("VEHICLE ENTERED");

      Serial.print("Vehicle: ");
      Serial.println(vehicleID);

      Serial.print("Slot: ");
      Serial.println(slot);

      Serial.print("Entry: ");
      Serial.println(getCurrentTime());

      return;
    }
  }
}


// ============================================================
// REGISTER VEHICLE EXIT
// ============================================================

void registerVehicleExit() {

  int selectedVehicle = -1;

  unsigned long oldestEntry =
    ULONG_MAX;


  // Find the oldest active vehicle

  for (int i = 0; i < 4; i++) {

    if (activeVehicles[i].active) {

      if (
        activeVehicles[i].entryMillis <
        oldestEntry
      ) {

        oldestEntry =
          activeVehicles[i].entryMillis;

        selectedVehicle =
          i;
      }
    }
  }


  // No registered vehicle

  if (selectedVehicle == -1) {

    addHistory(
      "EXIT",
      "--"
    );

    return;
  }


  String vehicleID =
    activeVehicles[selectedVehicle].vehicleID;

  String slot =
    activeVehicles[selectedVehicle].slot;


  // ==========================================================
  // CALCULATE PARKING DURATION
  // ==========================================================

  unsigned long durationMillis =
    millis() -
    activeVehicles[selectedVehicle].entryMillis;


  unsigned long durationMinutes =
    durationMillis / 60000;


  String duration =
    String(durationMinutes) +
    " min";


  // ==========================================================
  // ADD EXIT HISTORY
  // ==========================================================

  addHistory(
    "EXIT",
    slot
  );


  history[0].vehicleID =
    vehicleID;

  history[0].duration =
    duration;


  // Remove vehicle from active list

  activeVehicles[selectedVehicle].active =
    false;


  Serial.println();
  Serial.println("VEHICLE EXITED");

  Serial.print("Vehicle: ");
  Serial.println(vehicleID);

  Serial.print("Slot: ");
  Serial.println(slot);

  Serial.print("Exit: ");
  Serial.println(getCurrentTime());

  Serial.print("Duration: ");
  Serial.println(duration);
}
// ============================================================
// PROCESS VEHICLE ENTRY / EXIT EVENTS
// ============================================================

void processVehicleEvents() {

  // ==========================================================
  // ENTRY EVENT
  // ==========================================================

  if (
    vehicleEntering &&
    !previousEntryState &&
    availableSlots > 0
  ) {

    String selectedSlot =
      getAvailableSlot();

    if (selectedSlot != "--") {

      registerVehicleEntry(
        selectedSlot
      );

      Serial.println(
        "ENTRY EVENT REGISTERED"
      );
    }
  }


  // ==========================================================
  // EXIT EVENT
  // ==========================================================

  if (
    vehicleExiting &&
    !previousExitState
  ) {

    registerVehicleExit();

    Serial.println(
      "EXIT EVENT REGISTERED"
    );
  }


  // ==========================================================
  // SAVE CURRENT SENSOR STATES
  // ==========================================================

  previousEntryState =
    vehicleEntering;

  previousExitState =
    vehicleExiting;
}
// ============================================================
// HISTORY JSON
// ============================================================

String getHistoryJSON() {

  String json = "[";

  for (int i = 0; i < historyCount; i++) {

    if (i > 0) {
      json += ",";
    }

    json += "{";

    json += "\"id\":\"";
    json += history[i].vehicleID;
    json += "\",";

    json += "\"type\":\"";
    json += history[i].type;
    json += "\",";

    json += "\"date\":\"";
    json += history[i].date;
    json += "\",";

    json += "\"time\":\"";
    json += history[i].time;
    json += "\",";

    json += "\"slot\":\"";
    json += history[i].slot;
    json += "\",";

    json += "\"duration\":\"";
    json += history[i].duration;

    json += "\"";
    json += "}";
  }

  json += "]";

  return json;
}


// ============================================================
// LIVE STATUS API
// ============================================================

void handleStatus() {

  String json = "{";


  // ==========================================================
  // PARKING SLOTS
  // ==========================================================

  json += "\"slot1\":";
  json += slot1Occupied ? "true" : "false";
  json += ",";

  json += "\"slot2\":";
  json += slot2Occupied ? "true" : "false";
  json += ",";

  json += "\"slot3\":";
  json += slot3Occupied ? "true" : "false";
  json += ",";

  json += "\"slot4\":";
  json += slot4Occupied ? "true" : "false";
  json += ",";


  // ==========================================================
  // PARKING COUNTS
  // ==========================================================

  json += "\"occupied\":";
  json += String(occupiedSlots);
  json += ",";

  json += "\"available\":";
  json += String(availableSlots);
  json += ",";


  // ==========================================================
  // GATE
  // ==========================================================

  json += "\"gate\":";
  json += gateIsOpen ? "true" : "false";
  json += ",";


  // ==========================================================
  // ENTRY SENSOR
  // ==========================================================

  json += "\"entry\":";
  json += vehicleEntering ? "true" : "false";
  json += ",";


  // ==========================================================
  // EXIT SENSOR
  // ==========================================================

  json += "\"exit\":";
  json += vehicleExiting ? "true" : "false";
  json += ",";


  // ==========================================================
  // CURRENT DATE
  // ==========================================================

  json += "\"date\":\"";
  json += getCurrentDate();
  json += "\",";
  

  // ==========================================================
  // CURRENT TIME
  // ==========================================================

  json += "\"time\":\"";
  json += getCurrentTime();
  json += "\",";


  // ==========================================================
  // VEHICLE HISTORY
  // ==========================================================

  json += "\"history\":";
  json += getHistoryJSON();


  // ==========================================================
  // CLOSE JSON
  // ==========================================================

  json += "}";


  server.send(
    200,
    "application/json",
    json
  );
}
