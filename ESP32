<script>

// ============================================================
// UPDATE DATE AND TIME
// ============================================================

function updateDateTime(data) {

  const dateElement =
    document.getElementById("currentDate");

  const timeElement =
    document.getElementById("currentTime");


  if (dateElement) {

    dateElement.innerText =
      data.date;
  }


  if (timeElement) {

    timeElement.innerText =
      data.time;
  }
}


// ============================================================
// UPDATE PARKING SLOT
// ============================================================

function updateSlot(number, occupied) {

  const card =
    document.getElementById(
      "slot" + number
    );

  const text =
    document.getElementById(
      "slot" + number + "Text"
    );


  if (occupied) {

    card.classList.remove("free");

    card.classList.add("occupied");

    text.innerText =
      "OCCUPIED";

  }

  else {

    card.classList.remove("occupied");

    card.classList.add("free");

    text.innerText =
      "FREE";
  }
}


// ============================================================
// UPDATE VEHICLE HISTORY
// ============================================================

function updateHistory(history) {

  const historyBody =
    document.getElementById(
      "historyBody"
    );


  historyBody.innerHTML = "";


  // No history

  if (
    !history ||
    history.length === 0
  ) {

    historyBody.innerHTML = `

      <tr>

        <td
          colspan="6"
          style="
            text-align:center;
            color:#9ca3af;
          "
        >

          No vehicle activity yet

        </td>

      </tr>

    `;

    return;
  }


  // Display records

  history.forEach(
    function(vehicle) {

      const row =
        document.createElement("tr");


      const badgeClass =
        vehicle.type === "ENTRY"
        ? "entry-badge"
        : "exit-badge";


      row.innerHTML = `

        <td>

          <span class="vehicle-id">

            ${vehicle.id}

          </span>

        </td>


        <td>

          <span class="${badgeClass}">

            ${vehicle.type}

          </span>

        </td>


        <td>

          ${vehicle.date}

        </td>


        <td>

          ${vehicle.time}

        </td>


        <td>

          ${vehicle.slot}

        </td>


        <td>

          ${vehicle.duration}

        </td>

      `;


      historyBody.appendChild(row);

    }
  );
}


// ============================================================
// UPDATE COMPLETE DASHBOARD
// ============================================================

async function updateDashboard() {

  try {

    const response =
      await fetch("/api/status");


    const data =
      await response.json();


    // ========================================================
    // DATE AND TIME
    // ========================================================

    updateDateTime(data);


    // ========================================================
    // PARKING SLOTS
    // ========================================================

    updateSlot(
      1,
      data.slot1
    );

    updateSlot(
      2,
      data.slot2
    );

    updateSlot(
      3,
      data.slot3
    );

    updateSlot(
      4,
      data.slot4
    );


    // ========================================================
    // AVAILABLE SLOTS
    // ========================================================

    document.getElementById(
      "available"
    ).innerText =
      data.available + " / 4";


    // ========================================================
    // OCCUPIED SLOTS
    // ========================================================

    document.getElementById(
      "occupied"
    ).innerText =
      data.occupied;


    // ========================================================
    // OCCUPANCY PERCENTAGE
    // ========================================================

    const percentage =
      Math.round(
        (data.occupied / 4) * 100
      );


    document.getElementById(
      "occupancy"
    ).innerText =
      percentage + "%";


    // ========================================================
    // CAPACITY
    // ========================================================

    document.getElementById(
      "capacityOccupied"
    ).innerText =
      data.occupied;


    document.getElementById(
      "capacityAvailable"
    ).innerText =
      data.available;


    // ========================================================
    // PROGRESS BAR
    // ========================================================

    document.getElementById(
      "progress"
    ).style.width =
      percentage + "%";


    // ========================================================
    // GATE STATUS
    // ========================================================

    document.getElementById(
      "gateStatus"
    ).innerText =
      data.gate
      ? "OPEN"
      : "CLOSED";


    // ========================================================
    // ENTRY STATUS
    // ========================================================

    document.getElementById(
      "entryStatus"
    ).innerText =
      data.entry
      ? "VEHICLE DETECTED"
      : "READY";


    // ========================================================
    // EXIT STATUS
    // ========================================================

    document.getElementById(
      "exitStatus"
    ).innerText =
      data.exit
      ? "VEHICLE DETECTED"
      : "READY";


    // ========================================================
    // VEHICLE HISTORY
    // ========================================================

    updateHistory(
      data.history
    );

  }


  catch (error) {

    console.log(
      "ESP32 connection error:",
      error
    );

  }
}


// ============================================================
// FIRST UPDATE
// ============================================================

updateDashboard();


// ============================================================
// AUTOMATIC LIVE UPDATE
// ============================================================

setInterval(
  updateDashboard,
  500
);

</script>


